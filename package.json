{
  "name": "team-availability",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/schedule.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-team-availability --only firestore,auth 'node --test tests/rules.test.mjs'",
    "emulators": "npm run build && firebase emulators:start --project demo-team-availability",
    "seed": "node scripts/seed.mjs",
    "test:browser": "npm run build && firebase emulators:exec --project demo-team-availability --only firestore,auth,hosting 'node tests/browser.mjs'",
    "seed:demo": "node scripts/seed-demo.mjs",
    "deploy": "./deploy.sh",
    "deploy:all": "./deploy.sh --all"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
